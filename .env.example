# ============================================================
# InvestIA — variáveis de ambiente (copie para .env)
# ============================================================

# --- Banco de dados (PostgreSQL 16) ---
POSTGRES_USER=investia
POSTGRES_PASSWORD=investia_dev_password
POSTGRES_DB=investia
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investia

# --- Redis 7 (cache + rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Segurança ---
# Segredo HMAC do JWT (>= 32 bytes). TROQUE em producao.
JWT_SECRET=troque-este-segredo-por-uma-string-aleatoria-de-pelo-menos-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# CORS: origens permitidas do frontend (separadas por virgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting (requests por minuto) ---
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10

# --- Copiloto IA (OPCIONAL) ---
# Cliente compativel com OpenAI (chat/completions). Se vazio, o copiloto
# funciona em modo deterministico, sempre derivado de consultas reais ao banco.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Servidor ---
SERVER_PORT=8080
